{
  "name": "arm-js-library",
  "version": "2.9.3",
  "description": "API Resource Manager",
  "type": "module",
  "files": [
    "dist",
    "types",
    "DOCS.md",
    "LICENSE.md"
  ],
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/arm-js-library.js",
      "types": "./types/index.d.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "build:jsdocs": "jsdoc2md --private src/lib/api-resource-manager.js > DOCS.md",
    "build:dts": "tsc dist/arm-js-library.js --declaration --allowJs --emitDeclarationOnly --outFile types/index.d.ts --lib esnext --module esnext --skipLibCheck",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest run --reporter=verbose --watch"
  },
  "keywords": [
    "uuid",
    "state-management",
    "mobx",
    "json-api",
    "lodash",
    "md5",
    "centralized-data",
    "javascript",
    "reactjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaeljymsgutierrez/arm-js-library.git"
  },
  "author": "Michael Jyms Gutierrez",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "jsdoc-to-markdown": "^8.0.3",
    "jsdom": "^27.4.0",
    "miragejs": "^0.1.48",
    "typescript": "^5.5.4",
    "vite": "^7.3.5",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lodash": "^4.18.1",
    "md5": "^2.3.0",
    "mobx": "^6.16.1",
    "qs": "^6.16.0",
    "uuid": "^14.0.1"
  },
  "resolutions": {
    "vite": "7.3.5",
    "form-data": "4.0.6",
    "markdown-it": "14.3.1",
    "handlebars": "4.7.10",
    "js-yaml": "4.3.2",
    "brace-expansion": "1.1.21",
    "@humanfs/node": "0.16.8",
    "linkify-it": "5.0.2",
    "ws": "8.21.0",
    "flatted": "3.4.2",
    "vite-plugin-eslint/@rollup/pluginutils/picomatch": "2.3.2",
    "source-map-js": "1.2.2",
    "miragejs/lodash": "4.18.1",
    "jsdoc-to-markdown/**/lodash": "4.18.1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
